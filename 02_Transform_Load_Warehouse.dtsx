      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0CA9CAB9-06B3-413F-AF4A-A0C93E222F36}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET ANSI_NULLS ON;&#xA;SET QUOTED_IDENTIFIER ON;&#xA;SET ANSI_PADDING ON;&#xA;SET ANSI_WARNINGS ON;&#xA;SET ARITHABORT ON;&#xA;SET CONCAT_NULL_YIELDS_NULL ON;&#xA;SET NUMERIC_ROUNDABORT OFF;&#xA;&#xA;UPDATE d&#xA;SET&#xA;    Title = p.Title,&#xA;    ISBN13 = p.ISBN13,&#xA;    LanguageCode = p.LanguageCode,&#xA;    LanguageName = p.LanguageName,&#xA;    LanguageGroup = p.LanguageGroup&#xA;FROM dw.DimBook d&#xA;JOIN etl.vwBookPrepared p&#xA;    ON p.SourceBookID = d.SourceBookID;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
