                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    p.SourceBookID,
    p.Title,
    p.ISBN13,
    p.LanguageCode,
    p.LanguageName,
    p.LanguageGroup
FROM etl.vwBookPrepared p
WHERE NOT EXISTS (
    SELECT 1
    FROM dw.DimBook d
    WHERE d.SourceBookID = p.SourceBookID
);</property>
