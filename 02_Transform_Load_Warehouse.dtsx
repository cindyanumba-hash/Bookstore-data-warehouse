        <SQLTask:SqlTaskData
          SQLTask:Connection="{0CA9CAB9-06B3-413F-AF4A-A0C93E222F36}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET ANSI_NULLS ON;&#xA;SET QUOTED_IDENTIFIER ON;&#xA;SET ANSI_PADDING ON;&#xA;SET ANSI_WARNINGS ON;&#xA;SET ARITHABORT ON;&#xA;SET CONCAT_NULL_YIELDS_NULL ON;&#xA;SET NUMERIC_ROUNDABORT OFF;&#xA;&#xA;UPDATE d&#xA;SET&#xA;    SurveyResponseAvailable = p.SurveyResponseAvailable,&#xA;    PurchasePreference = p.PurchasePreference,&#xA;    DiscoverySource = p.DiscoverySource,&#xA;    ActiveCountryCount = p.ActiveCountryCount,&#xA;    AddressCountryCategory = p.AddressCountryCategory,&#xA;    SingleActiveCountryID = p.SingleActiveCountryID,&#xA;    SingleActiveCountryName = p.SingleActiveCountryName&#xA;FROM dw.DimCustomer d&#xA;JOIN etl.vwCustomerPrepared p&#xA;    ON p.SourceCustomerID = d.SourceCustomerID;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
